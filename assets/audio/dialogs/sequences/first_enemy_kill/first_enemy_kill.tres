[sub_resource type="Resource" id="Resource_tefeu"]
script = ExtResource("1_li8iu")
speaker = "LE CONCIERGE"
text = "Vous vous débrouillez plutôt bien."
audio = ExtResource("2_qj4pg")
is_intercom = true
intercom_audio = ExtResource("3_tybip")
metadata/_custom_type_script = "uid://dtp6gvwo6onsk"

[sub_resource type="Resource" id="Resource_p54lo"]
script = ExtResource("1_li8iu")
speaker = "HITOMI"
text = "Je m’en suis sortie. J’espère ne pas avoir à recommencer."
audio = ExtResource("3_qj4pg")
intercom_audio = ExtResource("5_bqk7d")
metadata/_custom_type_script = "uid://dtp6gvwo6onsk"

[sub_resource type="Resource" id="Resource_qj4pg"]
script = ExtResource("1_li8iu")
speaker = "LE CONCIERGE"
text = "De toute façon, il n’était plus vraiment humain. 
Et vous risquez d’en croiser d’autres comme lui."
audio = ExtResource("4_p54lo")
is_intercom = true
intercom_audio = ExtResource("7_30v2l")
metadata/_custom_type_script = "uid://dtp6gvwo6onsk"

[sub_resource type="Resource" id="Resource_2rbws"]
script = ExtResource("1_li8iu")
speaker = "HITOMI"
text = "Comment ça, plus humain… ? Qui sont ces gens ? On a reçu un appel à l’aide au commissariat… Ça aurait un rapport ? "
audio = ExtResource("5_2rbws")
metadata/_custom_type_script = "uid://dtp6gvwo6onsk"

[sub_resource type="Resource" id="Resource_voab7"]
script = ExtResource("1_li8iu")
speaker = "LE CONCIERGE"
text = "Ça, j’en doute. "
end_intercom = true
override_reply_gap = true
reply_gap = 1.0
audio = ExtResource("6_voab7")
is_intercom = true
intercom_audio = ExtResource("10_3ardw")
metadata/_custom_type_script = "uid://dtp6gvwo6onsk"

[sub_resource type="Resource" id="Resource_xtl1x"]
script = ExtResource("1_li8iu")
speaker = "HITOMI"
text = "Hein… ?"
override_reply_gap = true
reply_gap = 1.2
audio = ExtResource("7_ty83y")
intercom_audio = ExtResource("12_6ogsi")
metadata/_custom_type_script = "uid://dtp6gvwo6onsk"

[sub_resource type="Resource" id="Resource_ty83y"]
script = ExtResource("1_li8iu")
speaker = "HITOMI"
text = "Il faut que je trouve un moyen de joindre l’extérieur."
audio = ExtResource("8_am6oc")
metadata/_custom_type_script = "uid://dtp6gvwo6onsk"

