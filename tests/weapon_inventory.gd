extends SceneTree
const Inventory=preload("res://scripts/weapon_inventory.gd")
const Definition=preload("res://scripts/weapon_definition.gd")
var failures: Array[String]=[]
var report: Dictionary={}
var shot_events := 0
func _initialize() -> void:call_deferred("run")
func check(condition: bool,message: String) -> void:
	if not condition:failures.append(message);push_error(message)

func unit_checks() -> void:
	var eagle: Definition=load("res://assets/weapons/desert_eagle.tres")
	var second: Definition=eagle.duplicate();second.id=&"test_second";second.magazine_capacity=5;second.starting_ammo=3;second.starting_reserve=0
	var other: Definition=second.duplicate();other.id=&"test_other";other.ammo_type=&"test_shells";other.starting_reserve=4
	var inv := Inventory.new()
	check(inv.add_weapon(eagle)==0 and inv.add_weapon(second)==1 and inv.add_weapon(other)==2,"Weapons occupy stable inventory slots")
	check(inv.equip(0,true),"First weapon can be equipped immediately")
	check(inv.try_fire(),"Ready loaded weapon can fire")
	check(not inv.try_fire(),"Cadence is enforced inside the public weapon state")
	check(inv.ammo()==11 and inv.reserve()==24,"Shot consumes exactly one magazine round")
	check(inv.begin_reload() and not inv.begin_reload(),"Only one reload can be pending")
	check(not inv.try_fire(),"Reload blocks firing")
	inv.advance(.1)
	check(inv.ammo()==11 and inv.reserve()==24,"Reload does not transfer ammo early")
	check(inv.equip(1),"Switching during reload is supported")
	check(not inv.try_fire() and not inv.begin_reload(),"Equip delay blocks fire and reload")
	inv.advance(5)
	check(inv.weapons[0].ammo==11 and inv.reserve()==24,"Cancelled reload does not refill holstered weapon or spend reserve")
	check(inv.ammo()==3,"Second weapon retains its own loaded magazine")
	inv.set_ammo(1);inv.equip(0,true)
	check(inv.ammo()==11 and inv.weapons[1].ammo==1,"Switching preserves both magazine counts")
	check(inv.add_weapon(eagle)==0 and inv.ammo()==11 and inv.reserve()==24,"Acquiring a duplicate ID never resets ammo or grants extra reserve")
	inv.set_ammo(4);inv.set_reserve(2);inv.begin_reload();inv.advance(50)
	check(inv.ammo()==6 and inv.reserve()==0,"Reload transfers only the available reserve")
	inv.advance(50)
	check(inv.ammo()==6 and inv.reserve()==0,"Completed reload cannot transfer twice")
	check(not inv.begin_reload(),"Empty reserve prevents reload")
	inv.equip(2,true);inv.add_ammo(&"magnum",7)
	check(inv.reserve()==4,"Pickup for another ammo type leaves current reserve unchanged")
	inv.equip(1,true)
	check(inv.reserve()==7,"Same ammunition type shares one reserve pool across weapons")
	inv.active_definition().magazine_capacity=8
	check(eagle.magazine_capacity==12 and second.magazine_capacity==5,"Runtime weapon tuning does not mutate source resources")
	inv.set_ammo(999);inv.set_reserve(-8)
	check(inv.ammo()==8 and inv.reserve()==0,"Ammo and reserves remain within valid bounds")
	check(not inv.begin_reload() and not inv.equip(99),"Invalid reload and slot requests are harmless")
	inv.equip(0,true);inv.set_ammo(1);inv.try_fire();inv.equip(1,true);inv.equip(0,true)
	check(not inv.try_fire(),"Fast switching cannot bypass a weapon's cooldown")
	inv.advance(.3);inv.set_ammo(0);inv.set_reserve(0)
	check(inv.dry_fire() and not inv.dry_fire(),"Empty trigger has its own repeat limit")
	inv.advance(.3);inv.set_ammo(2);inv.set_reserve(4);inv.begin_reload();inv.cancel_reload();inv.advance(10)
	check(inv.ammo()==2 and inv.reserve()==4,"Explicit cancellation is lossless")
	var untouched := Inventory.new();untouched.add_weapon(eagle);untouched.equip(0,true)
	check(untouched.ammo()==12 and untouched.reserve()==24,"Different inventories never share runtime state")
	report.unit_checks="passed" if failures.is_empty() else "failed"

func run() -> void:
	unit_checks()
	var game=load("res://scenes/main.tscn").instantiate();root.add_child(game)
	game.set_process(false);game.set_process_input(false);game.psx_renderer.set_process(false)
	for enemy in game.enemies:enemy.set_physics_process(false)
	var p=game.player;p.set_process(false);p.set_physics_process(false)
	var renderer=game.psx_renderer
	var source: Definition=load("res://assets/weapons/desert_eagle.tres")
	check(p.weapon_definition().id==&"desert_eagle","Desert Eagle is the equipped starting weapon")
	check(source.shot_sound.resource_path=="res://assets/audio/weapons/d_eagle/eagle_shoot.wav","Desert Eagle uses the requested source file")
	check(p.sounds.shot.stream==root.get_node("PSXAudio").prepare(source.shot_sound),"Equipped sound is the prepared PS1 version of that exact file")
	check(p.sounds.shot.stream.is_class("AudioStreamPSX"),"Weapon audio retains the automatic SPU processing")
	check(not p.weapon_definition().automatic,"Desert Eagle trigger is semi-automatic")
	p.fired.connect(func(_origin: Vector3,_direction: Vector3):shot_events+=1)
	check(p.shoot() and not p.shoot() and shot_events==0,"Accepted trigger starts one pending shot without an early discharge")
	p.motion.advance_motion(0,p.motion.weapon.fire_event_delay);p._apply_upper_body_look()
	check(shot_events==1,"Image 2 emits exactly one gameplay shot per accepted trigger")
	var first=p.motion.weapon
	var entries_before: int=renderer.entries.size()
	var second: Definition=source.duplicate();second.id=&"test_other_gun";second.ammo_type=&"test_shells";second.starting_ammo=4;second.starting_reserve=6;second.shot_sound=null
	second.reload_clip="unavailable_test_reload"
	var slot: int=p.give_weapon(second)
	check(slot==1 and renderer.entries.size()>entries_before,"Acquired weapon geometry is registered before switching")
	var entries_after: int=renderer.entries.size()
	check(p.reload_weapon(),"Gameplay starts a valid reload")
	check(p.equip_weapon(slot) and p.reload_left==0,"Switch cancels old reload timer")
	check(p.motion.get_reload_duration()==0 and p.motion.aim_pose.reload_time<0,"Equipping a gun without a body reload clip cannot reuse the previous gun's reload layer")
	check(p.sounds.reload.playing==false and p.sounds.shot.stream==null,"Switch stops the old reload and replaces the firing sound")
	check(first.flash_time_left==0 and not first.is_visible_in_tree(),"Holstered weapon leaves no old flash or visible model")
	check(not p.shoot() and not p.reload_weapon(),"Gameplay respects equip delay")
	p.weapon_inventory.advance(.3)
	var pickup := {"kind":"ammo","label":"MAGNUM","node":null,"pos":Vector3.ZERO,"ammo_type":&"magnum","amount":12,"taken":false}
	game.nearest=pickup;game.interact()
	check(p.reserve==6 and p.weapon_inventory.reserves[&"magnum"]==36,"Pickup credits its own ammo type while a different gun is equipped")
	game.nearest=pickup;game.interact()
	check(p.weapon_inventory.reserves[&"magnum"]==36,"Taken ammo pickup cannot be collected twice")
	check(p.shoot() and shot_events==1 and p.ammo==3,"Newly equipped weapon queues a validated shot")
	p.motion.advance_motion(0,p.motion.weapon.fire_event_delay);p._apply_upper_body_look()
	check(shot_events==2,"Newly equipped weapon dispatches its shot on image 2")
	p.equip_weapon(0);p.weapon_inventory.advance(.3)
	check(absf(p.motion.get_reload_duration()-34.0/24)<.00001,"Re-equipping the Desert Eagle restores its authored reload timing")
	check(p.ammo==11 and p.reserve==36,"Returning to Desert Eagle preserves its magazine and reserve")
	check(p.sounds.shot.stream==root.get_node("PSXAudio").prepare(source.shot_sound),"Returning to Desert Eagle restores its sound")
	check(renderer.entries.size()==entries_after,"Switching uses cached geometry without rebuilding or duplication")
	renderer._process(0)
	check(renderer.triangle_count>0,"Native renderer still draws after repeated weapon changes")
	p.ammo=2;p.reserve=3;p.reload_weapon();p.take_damage(p.health)
	p.weapon_inventory.advance(5)
	check(p.ammo==2 and p.reserve==3 and not p.shoot() and not p.equip_weapon(1),"Death cancels reload and blocks combat actions")
	report.shot_events=shot_events;report.cached_weapon_entries=entries_after-entries_before
	FileAccess.open("res://docs/weapon-inventory-validation.json",FileAccess.WRITE).store_string(JSON.stringify({"measurements":report,"failures":failures},"\t"))
	for audio in game.find_children("*","AudioStreamPlayer",true,false):audio.stop()
	for audio in game.find_children("*","AudioStreamPlayer3D",true,false):audio.stop()
	await create_timer(.08).timeout;game.queue_free();await process_frame;await create_timer(.08).timeout
	print("WEAPON_INVENTORY_OK: individual magazines, typed reserves, cadence, semi-auto data, reload cancellation, equip delay, pickups, sound routing, cached visuals and death" if failures.is_empty() else "WEAPON_INVENTORY_FAILED "+str(failures))
	quit(0 if failures.is_empty() else 1)
