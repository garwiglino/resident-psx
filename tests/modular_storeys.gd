extends SceneTree
const Layout=preload("res://scripts/modular_map/layout.gd")
var Map: Script
var failures: Array[String]=[]
func _initialize() -> void:call_deferred("run")
func check(value: bool,message: String) -> void:
	if not value:failures.append(message);push_error(message)
func settle() -> void:
	await process_frame;await physics_frame;await physics_frame
func ray(at: Vector3,to: Vector3) -> Dictionary:
	return root.world_3d.direct_space_state.intersect_ray(PhysicsRayQueryParameters3D.create(at,to))
func run() -> void:
	Map=load("res://scripts/modular_map/map_3d.gd")
	var layout := Layout.new()
	layout.paint_floor(Vector2i.ZERO)
	check(layout.has_floor(Vector2i.ZERO) and layout.effective_edges().is_empty() and not layout.has_ceiling(Vector2i.ZERO),"Sol paints a floor without walls or ceiling")
	layout.paint_edge("h:4:0",Layout.Kind.WALL,"wall_loop")
	check(layout.effective_edges().size()==1 and not layout.cells.has(Vector2i(4,0)),"Mur paints independently of floors")
	layout.paint_edge("h:4:0",Layout.Kind.PASSAGE,"")
	check(layout.effective_edges().is_empty(),"Passage removes a freestanding wall")
	layout.paint_ceiling(Vector2i(5,0))
	check(layout.has_ceiling(Vector2i(5,0)) and not layout.has_floor(Vector2i(5,0)),"Ceiling can be painted without floor or walls")
	var room := layout.add_room()
	for x in 2:
		layout.paint_cell(Vector2i(x,2),room)
		layout.paint_cell(Vector2i(x,2),room,1)
	layout.paint_cell(Vector2i(4,2),room,-1)
	layout.paint_floor(Vector2i(0,2),room,0,true)
	check(not layout.has_floor(Vector2i(0,2)) and layout.effective_edges().has("h:0:2"),"Removing only floor preserves the room walls")
	layout.paint_floor(Vector2i(0,2))
	for level in [0,1,-1]:layout.paint_edge("h:0:2",Layout.Kind.DOOR,"solid",level)
	layout.edges_at(1)["h:0:2"].lock_mode=2
	check(layout.effective_edges(-1).has("h:0:2") and layout.level_ids()==[-1,0,1],"Basement and upper floor have independent edges")
	var saved := layout.snapshot();layout.paint_opening(Vector2i(1,2),1)
	check(not layout.has_floor(Vector2i(1,2),1) and not layout.has_ceiling(Vector2i(1,2),0),"Stair opening removes upper floor and lower ceiling together")
	layout.restore(saved)
	check(layout.has_floor(Vector2i(1,2),1) and layout.has_ceiling(Vector2i(1,2)),"Undo snapshot restores the slab and room ceiling")
	layout.paint_opening(Vector2i(1,2),1)
	var map: Node3D=Map.new();map.layout=layout;map.event_namespace="storeys_test";root.add_child(map);await settle()
	check(map.generated.get_node("Etage_1").position.y==3 and map.generated.get_node("Etage_-1").position.y==-3,"Each storey is built at the correct 3 m height")
	var down := ray(Vector3(1,3.5,5),Vector3(1,2.5,5))
	check(not down.is_empty() and is_equal_approx(down.position.y,3),"Upper floor collision surface is exactly Y=3, without a ceiling lip")
	var up := ray(Vector3(1,2.5,5),Vector3(1,3.5,5))
	check(not up.is_empty() and is_equal_approx(up.position.y,2.9),"Lower ceiling shares the underside of the upper floor slab")
	check(ray(Vector3(3,2.5,5),Vector3(3,3.5,5)).is_empty(),"Stair opening has no invisible floor or ceiling collision")
	check(not ray(Vector3(9,-2.5,5),Vector3(9,-3.5,5)).is_empty(),"Basement floor collision exists below ground")
	check(map.generated.get_node("Bord_h_0_2/Porte").door_id==&"storeys_test.h_0_2","Existing ground floor door identities stay unchanged")
	var upper: Node=map.generated.get_node("Etage_1/Bord_h_0_2/Porte")
	check(upper.door_id==&"storeys_test.etage_1.h_0_2" and upper.permanently_locked and upper.permanent_dialogue_pool.resource_path.ends_with("/locked_doors/locked_doors.tres"),"Upper door uses an independent world ID and the permanent-lock dialogue bank")
	check(upper.locked and not upper.is_open and not upper.open(),"Permanent door cannot open via world interaction")
	upper.set_locked(false)
	check(upper.locked,"Permanent door refuses programmatic unlock")
	root.get_node("WorldEvents").set_fact(&"door.storeys_test.etage_1.h_0_2.open",true)
	check(not upper.is_open and upper.locked,"World facts cannot bypass a permanent lock")
	var packed := PackedScene.new();packed.pack(map)
	var path := "res://exports/modular/storeys_roundtrip.tscn";ResourceSaver.save(packed,path)
	var restored: Node3D=ResourceLoader.load(path,"PackedScene",ResourceLoader.CACHE_MODE_IGNORE).instantiate()
	check(restored.layout.snapshot()==layout.snapshot(),"All storeys and floor/ceiling masks survive save and load")
	restored.free();map.free()
	var high: Node3D=Map.new();high.layout=Layout.new();high.layout.paint_floor(Vector2i(4,5),0,2)
	root.add_child(high);root.get_node("LevelRuntime")._ensure_spawn(high)
	check(high.get_node("Gameplay/PlayerSpawn").position.is_equal_approx(Vector3(9,6.05,11)),"A map painted only upstairs spawns the player on that storey")
	high.free()
	var legacy := Layout.new();legacy.restore({"cells":{Vector2i.ZERO:1},"edges":{},"rooms":{1:"Old room"},"next_room":2})
	check(legacy.effective_edges().size()==4 and legacy.has_ceiling(Vector2i.ZERO),"Existing maps retain their walls and ceilings without migration")
	var result := {"ok":failures.is_empty(),"errors":failures}
	FileAccess.open("res://docs/modular-storeys-validation.json",FileAccess.WRITE).store_string(JSON.stringify(result,"\t"))
	print("MODULAR_STOREYS_OK " if failures.is_empty() else "MODULAR_STOREYS_FAILED ",JSON.stringify(result));quit(0 if failures.is_empty() else 1)
